# capture-insights environment
# Copy to .env and fill real values. Never commit .env

# --- Local LLM (Ollama) - Recommended for 8GB VRAM ---
OLLAMA_HOST=http://localhost:11434
# Primary local model — qwen3.5:9b (quantized fits 8GB VRAM). Pull: ollama pull qwen3.5:9b
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TEMPERATURE=0.3

# Optional: Use xAI Grok models via their OpenAI-compatible API when you want bigger/better reasoning
# Get key at https://console.x.ai/
# The code can fallback or let you choose per request.
XAI_API_KEY=your_xai_key_here   # or leave blank to stay 100% local

# --- Data store (we use ONE simple file - DuckDB) ---
# Plain English: This is like one giant, super-fast spreadsheet file that understands SQL questions.
# No separate vector database (Chroma) for MVP to avoid complexity and redundancy.
# DuckDB can do both regular analysis AND semantic search later if we need it.
DUCKDB_PATH=data/capture.duckdb

# Optional advanced (not used in early chunks):
# CHROMA_PATH=data/chroma
# POSTGRES_URL=postgresql://...   # only if you ever need multi-user / team shared DB

# --- API keys for federal-contracting MCPs (free registration) ---
# SAM.gov (https://sam.gov/ or api.data.gov)
SAM_API_KEY=your_sam_api_key_here
SAM_API_BASE_URL=https://api.sam.gov/opportunities/v2/search

# BLS (https://data.bls.gov/registrationEngine/)
BLS_API_KEY=your_bls_api_key_here

# api.data.gov key (covers several: Per Diem, Regulations.gov, etc.)
DATA_GOV_API_KEY=your_datagov_key_here

# --- Other (optional for future) ---
# GSA_CALC etc are public, no key for basic use

# --- App ---
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO

# --- Privacy / features ---
ENABLE_LIVE_MCPS=true
ENABLE_AI_FEATURES=true
# ALLOW_NET_FOR_MCP=true  (toggle for full offline mode)

# --- Global skill runtime caps (optional — prefer Settings → Skill runtime caps UI) ---
# Persisted defaults live in data/settings/skill_runtime.json. Uncomment to lock via .env:
# SKILL_TOOLS_MAX_TURNS=24
# SKILL_TOOLS_LLM_TIMEOUT=240
# SKILL_TOOLS_LLM_MAX_TOKENS=4096
# MCP_HANDSHAKE_TIMEOUT=15
# MCP_TOOL_CALL_TIMEOUT=90
# MCP_SHUTDOWN_TIMEOUT=3
# SKILL_TOOLS_MAX_TOOL_RESULT_CHARS=24000
# SKILL_TOOLS_MAX_READ_BYTES=200000
# SKILL_TOOLS_MAX_WRITE_BYTES=1000000
# SKILL_TOOLS_MAX_SCRIPT_SECONDS=120
# SKILL_TOOLS_MAX_KG_ENTITIES_PER_TYPE=50
# SKILL_TOOLS_MAX_KG_CHUNKS=30
# SKILL_TOOLS_MAX_CHUNKS_PER_ENTITY=5
# SKILL_TOOLS_MAX_RELATIONSHIPS_PER_ENTITY=20
# SKILL_COLLECTOR_IDV_PAGE_LIMIT=25
# SKILL_COLLECTOR_MAX_IDV_PAGES=200
# SKILL_COLLECTOR_TX_PAGE_LIMIT=5000
# SKILL_COLLECTOR_MAX_TX_PAGES=80
# SKILL_COLLECTOR_MAX_ORDERS=250
